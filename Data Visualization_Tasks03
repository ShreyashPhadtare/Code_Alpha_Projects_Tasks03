import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# TASK 3: DATA VISUALIZATION

# Step 1: Create a sample dataset
data = {
    "Product": ["Laptop", "Mobile", "Headphones", "Tablet", "Keyboard", "Mouse"],
    "Sales": [45000, 30000, 12000, 22000, 5000, 3000],
    "Units_Sold": [15, 30, 40, 20, 50, 60],
    "Customer_Rating": [4.5, 4.3, 4.1, 4.2, 3.9, 4.0]
}

df = pd.DataFrame(data)

# Step 2: Display the dataset
print("Sales Dataset:")
print(df)

print("\nDataset Information:")
df.info()

print("\nSummary Statistics:")
print(df.describe())

# Set the chart style
sns.set_theme(style="whitegrid")

# Step 3: Bar Chart - Sales by Product
plt.figure(figsize=(9, 5))
sns.barplot(data=df, x="Product", y="Sales")
plt.title("Total Sales by Product")
plt.xlabel("Product")
plt.ylabel("Sales (Rs.)")
plt.xticks(rotation=25)
plt.tight_layout()
plt.show()

# Step 4: Bar Chart - Units Sold
plt.figure(figsize=(9, 5))
sns.barplot(data=df, x="Product", y="Units_Sold")
plt.title("Units Sold by Product")
plt.xlabel("Product")
plt.ylabel("Units Sold")
plt.xticks(rotation=25)
plt.tight_layout()
plt.show()

# Step 5: Pie Chart - Sales Percentage
plt.figure(figsize=(7, 7))
plt.pie(
    df["Sales"],
    labels=df["Product"],
    autopct="%1.1f%%",
    startangle=90
)
plt.title("Percentage Share of Sales by Product")
plt.tight_layout()
plt.show()

# Step 6: Histogram - Sales Distribution
plt.figure(figsize=(8, 5))
plt.hist(df["Sales"], bins=5, edgecolor="black")
plt.title("Distribution of Product Sales")
plt.xlabel("Sales (Rs.)")
plt.ylabel("Number of Products")
plt.tight_layout()
plt.show()

# Step 7: Scatter Plot - Units Sold vs Sales
plt.figure(figsize=(8, 5))
sns.scatterplot(
    data=df,
    x="Units_Sold",
    y="Sales",
    hue="Product",
    s=120
)
plt.title("Units Sold vs Sales")
plt.xlabel("Units Sold")
plt.ylabel("Sales (Rs.)")
plt.tight_layout()
plt.show()

# Step 8: Heatmap - Correlation Analysis
numeric_data = df[
    ["Sales", "Units_Sold", "Customer_Rating"]
]

correlation = numeric_data.corr()

plt.figure(figsize=(7, 5))
sns.heatmap(
    correlation,
    annot=True,
    cmap="coolwarm",
    fmt=".2f"
)
plt.title("Correlation Heatmap")
plt.tight_layout()
plt.show()

# Step 9: Display Key Insights
top_sales_product = df.loc[df["Sales"].idxmax(), "Product"]
top_units_product = df.loc[df["Units_Sold"].idxmax(), "Product"]

print("\nKEY INSIGHTS")
print("-------------------------")
print("Product with highest sales:", top_sales_product)
print("Product with most units sold:", top_units_product)
print("Total sales: Rs.", df["Sales"].sum())
print("Average sales: Rs.", df["Sales"].mean())

print("\nData visualization completed successfully!")
